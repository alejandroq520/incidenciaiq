# DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/incident_iq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM (OpenAI ChatGPT API) - optional. Leave empty to use the deterministic fallback classifier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=text

# APP
APP_NAME=IncidentIQ
APP_VERSION=1.2.0
ENVIRONMENT=development

# SEED (en producción usa SEMBRAR_DEMO_DATA=false para empezar limpio)
SEMBRAR_DEMO_DATA=true
SEMBRAR_DEMO_INCIDENCIAS=130